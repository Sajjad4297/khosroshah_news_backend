# Server Configuration
PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# Database Configuration (MySQL)
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=khosroshah_news

# Security & Authentication
# In production, JWT_SECRET must be set to a high-entropy string (e.g. openssl rand -hex 32)
JWT_SECRET=your_long_random_jwt_secret_key_change_me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_strong_password_in_production

# CORS Configuration (comma-separated allowed origins)
CORS_ALLOWED_ORIGINS=http://localhost:4000,https://backend.navayetabriz.ir
